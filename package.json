    "@codemirror/view": "^6.36.2",
    "@types/node": "^22.13.1",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "fractional-indexing": "^3.4.0"
  }
}
